{
  "name": "lyubomirevtimov-lab",
  "version": "0.0.1",
  "private": true,
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "24.22.2"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "certificate": "node scripts/certificate-pdf.mjs",
    "previews": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/previews.mjs",
    "dev": "wrangler dev --port 8788",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail lyubomirevtimov-lab"
  },
  "devDependencies": {
    "wrangler": "4.158.0"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false,
    "workerd": false
  }
}
